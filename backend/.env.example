NODE_ENV=development
PORT=3000

# Required in production
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=ai_interviewer
MONGO_MAX_POOL_SIZE=20
ADMIN_API_KEY=replace-with-a-long-random-secret

# Recruiter account sessions
AUTH_SESSION_HOURS=12

# AI interview generation (optional locally; recommended in production)
OPENAI_API_KEY=
OPENAI_INTERVIEW_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=2

# Candidate email invitations (optional)
RESEND_API_KEY=
FROM_EMAIL=Interviews <interviews@example.com>

# Browser origins / invite links
FRONTEND_URL=http://localhost:5173
PRODUCTION_FRONTEND_URL=
CORS_ORIGINS=

# Keep demo endpoints off in production
ENABLE_DEMO_MODE=false
